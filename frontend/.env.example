# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# Next Auth (JWT encryption)
# Generate with: npx auth secret
AUTH_SECRET=""

# Database (Prisma SQLite or PostgreSQL)
DATABASE_URL="file:./db.sqlite"

# ClipSense AI FastAPI Backend URL (Required for processing & highlight streaming)
# For local development: "http://localhost:8000"
# For Hugging Face Spaces production: "https://<username>-<space_name>.hf.space"
# (e.g., "https://namanbhatia-nb-clipsense-ai.hf.space")
NEXT_PUBLIC_CLIPSENSE_API_URL="http://localhost:8000"

# Optional: Google Sign-in OAuth (login only, no YouTube upload permissions required)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Optional: Base URL for redirects
# BASE_URL="http://localhost:3000"

# Optional: Polar Payment Checkout
# POLAR_ACCESS_TOKEN=""
# POLAR_WEBHOOK_SECRET=""
# POLAR_PRODUCT_SMALL_ID=""
# POLAR_PRODUCT_MEDIUM_ID=""
# POLAR_PRODUCT_LARGE_ID=""
