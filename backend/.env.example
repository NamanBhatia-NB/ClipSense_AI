# ClipSense Backend Environment Variables Example
# Duplicate this file as .env and add your secrets. Do not commit .env to version control.

# Gemini API Key (optional: used for LLM semantic proposals; offline mock used if omitted)
GEMINI_API_KEY=""

# Authentication secret token (optional)
AUTH_TOKEN="test-secret-token"

# AWS S3 Storage Configuration (optional)
AWS_S3_BUCKET="ai-podcast-clipper-saas-buckets"
AWS_REGION="us-east-1"
