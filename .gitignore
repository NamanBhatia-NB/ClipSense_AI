# macOS
.DS_Store
.AppleDouble
.LSOverride

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.swp
*.swo
*.swn
runs/
**/runs/

# Editor directories and files
.vscode/
**/.vscode/
*.sublime-workspace

*.mp4

# Model weights and checkpoints
*.pth
*.pt
*.bin
*.model
*.onnx

# Legacy reference files, scratch scripts, and external modules
ai-podcast-clipper-backend/main.py
ai-podcast-clipper-backend/temp.py
ai-podcast-clipper-backend/video_cut.py
ai-podcast-clipper-backend/ytdownload.py
