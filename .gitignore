# macOS
.DS_Store
.AppleDouble
.LSOverride

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.swp
*.swo
*.swn

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace

*.mp4

# Environment variables
.env
*.env
**/.env
**/.env*.local
!**/.env.example

# Frontend (Next.js)
ai-podcast-clipper-frontend/node_modules/
ai-podcast-clipper-frontend/.next/
ai-podcast-clipper-frontend/out/
ai-podcast-clipper-frontend/*.tsbuildinfo
ai-podcast-clipper-frontend/next-env.d.ts

# Python bytecode and caches
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
